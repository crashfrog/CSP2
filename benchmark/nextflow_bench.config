/*
 * Resource caps for benchmarking CSP2 on a modest machine (this box: 4 vCPU, ~3.8 GiB RAM).
 *
 * The stock pipeline labels request mummerMem=4GB and skesaMem=12GB, which the `local`
 * executor cannot satisfy here (it would refuse to schedule / hang). This config, layered
 * with `-c`, shrinks the per-task footprint and caps executor concurrency so runs fit in
 * RAM. It changes ONLY scheduling/resources -- never algorithm parameters -- so pipeline
 * OUTPUT is unaffected and stays comparable across runs.
 *
 * Apply with:  nextflow run CSP2.nf -profile standard -c benchmark/nextflow_bench.config ...
 */

executor {
    name       = 'local'
    cpus       = 4
    memory     = '3.4 GB'
    // Serialize: the local executor's `memory` directive is advisory, not a hard cap,
    // and compileMUMmer.py spawns BBMap's kmercountexact.sh (a JVM that grabs most of
    // RAM). Concurrent tasks OOM-kill (exit 137) on a 3.8 GiB box. One task at a time is
    // slow but reliable; JVM heap is also capped via _JAVA_OPTIONS in run.sh.
    queueSize  = 1
}

process {
    cpus   = 1
    memory = '1 GB'

    withLabel: 'mummerMem' {
        cpus   = 1
        memory = '1 GB'
    }
    withLabel: 'skesaMem' {
        cpus   = 2
        memory = '1500 MB'
    }
}

// mash triangle and any `${params.cores}` consumer: match the box.
params.cores = 4
